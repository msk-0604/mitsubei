{
  "name": "mitubei-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mitubei --local",
    "db:migrate:remote": "wrangler d1 migrations apply mitubei --remote",
    "db:seed:local": "node scripts/seed.mjs",
    "org:create": "node scripts/create-org.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler d1 migrations apply mitubei --remote && wrangler deploy",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api"
  },
  "dependencies": {
    "better-auth": "^1.7.21",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
